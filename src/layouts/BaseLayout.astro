---
import "../styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
const { title, useECharts } = Astro.props;
---

<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/icon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        {
            useECharts && (
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/echarts@5.6.0/dist/echarts.min.js"
                    crossorigin="anonymous"
                />
                <script
                    is:inline src="https://cdn.jsdelivr.net/npm/echarts-gl@2.0.9/dist/echarts-gl.min.js" crossorigin="anonymous"/>
                <script
                    is:inline
                    src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"
                    crossorigin="anonymous"/>
            )
        }
        <title>{title}</title>
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>
