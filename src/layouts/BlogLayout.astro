---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogHero from "@/components/BlogHero.astro";
interface Props {
    frontmatter: CollectionEntry<"blog">;
}
const { frontmatter } = Astro.props;
const { headings } = await render(frontmatter);
---

<script>
    import "../scripts/blog.ts";
</script>

<BaseLayout
    title={frontmatter.data.title}
    useECharts={frontmatter.data.useECharts}
>
    <div class="gap-x-10 lg:flex lg:items-start">
        {
            !!headings.length && (
                <aside class="table-of-contents-blogpost sticky top-28 mt-10 order-2 -mr-0 hidden basis-72 lg:block">
                    <h2 class="table-of-contents-blogpost font-semibold">
                        Table of Contents
                    </h2>
                    <ul class="mt-4 text-xs">
                        {headings.map(({ depth, slug, text }) => (
                            <li class="line-clamp-2 hover:text-accent">
                                <a
                                    class={`block ${depth <= 2 ? "mt-3" : "mt-2 pl-3 text-[0.6875rem]"}`}
                                    href={`#${slug}`}
                                    aria-label={`Scroll to section: ${text}`}
                                >
                                    <span>
                                        {depth == 1 || depth == 2 ? "§" : ""}
                                    </span>{" "}
                                    {text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </aside>
            )
        }
        <article class="flex-grow break-words">
            <div id="blog-hero"><BlogHero content={frontmatter} /></div>
            <div
                class="prose flex-none flex-col sm:flex max-w-5xl prose-base prose-cactus mt-12 prose-headings:font-semibold prose-headings:before:absolute prose-headings:before:-ml-4 prose-headings:before:text-accent prose-headings:before:content-['§'] prose-th:before:content-none"
            >
                <slot />
            </div>
        </article>
    </div>
    <button
        id="to-top-btn"
        class="z-90 fixed bottom-8 right-4 lg:right-64 flex h-12 w-12 translate-y-28 items-center justify-center rounded-full border-1 border-[var(--theme-text)] bg-[var(--theme-bg)]/50 backdrop-blur-sm transition-all duration-150 hover:border-2 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 shadow-md"
        aria-label="Back to Top"
        data-show="false"
        ><svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="var(--theme-text)"
            class="h-6 w-6"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
        </svg>
    </button>
</BaseLayout>
