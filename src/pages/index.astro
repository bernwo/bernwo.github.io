---
import { getCollection } from "astro:content";
import { sortMDByDate, getPackageVersion } from "../utils/utils.ts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/SocialList.astro";
import LaTeXLogo from "@/components/logo/LaTeXLogo.astro";
import ThingsIWorkOn from "@/components/homepage/ThingsIWorkOn.astro";
const title = "Home • Wo";

const remarkMathInfo = getPackageVersion("remark-math");
const rehypeMathJaxInfo = getPackageVersion("rehype-mathjax");
const rehypeCitationInfo = getPackageVersion("rehype-citation");
const remarkGfmInfo = getPackageVersion("remark-gfm");
const MAX_POSTS = 11;
const allPosts = await getCollection("blog");
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
---

<BaseLayout title={title}>
    <h1 class="hello-world title mb-6 mt-[-3.2rem] text-2xl">
        <svg
            style="display: inline;"
            xmlns="http://www.w3.org/2000/svg"
            width="310"
            height="86"
            viewBox="0 0 310 86"
            ><text
                x="43.5%"
                dominant-baseline="middle"
                text-anchor="middle"
                y="80%">Hello World! I'm Wo</text
            ><path
                transform="translate(275, 33) scale(1.4)"
                d="M12 3c5.514 0 10 3.592 10 8.007 0 4.917-5.144 7.961-9.91 7.961-1.937 0-3.384-.397-4.394-.644-1 .613-1.594 1.037-4.272 1.82.535-1.373.722-2.748.601-4.265-.837-1-2.025-2.4-2.025-4.872 0-4.415 4.486-8.007 10-8.007zm0-2c-6.338 0-12 4.226-12 10.007 0 2.05.739 4.063 2.047 5.625.055 1.83-1.023 4.456-1.993 6.368 2.602-.47 6.301-1.508 7.978-2.536 1.417.345 2.774.503 4.059.503 7.084 0 11.91-4.837 11.91-9.961-.001-5.811-5.702-10.006-12.001-10.006z"
            ></path></svg
        >
    </h1>
    <p class="mb-4">
        and I'm a PhD researcher at the
        <a
            href="https://www.cqt.sg/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block coloured-link"
        >
            Centre for Quantum Technologies
        </a> at the National University of Singapore in <a
            href="https://qovelab.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block coloured-link">Qovelab</a
        > where I'm working together with a team of talented people on achieving
        optic-microwave quantum entanglement.
    </p>
    <ThingsIWorkOn />
    <SocialList />
    <section aria-label="Blog post list" class="mt-16">
        <h2 class="title mb-4 text-xl">Posts</h2>
        <ul class="space-y-4 sm:space-y-2">
            {
                allPostsByDate.map((p) => (
                    <li class="flex flex-col gap-x-2 sm:flex-row">
                        <PostPreview post={p} />
                    </li>
                ))
            }
        </ul>
    </section>
    <section class="mt-16">
        <h2 class="title mb-4 text-xl">Website tech stack</h2>
        <p class="mb-4">
            I used <a
                href="https://astro.build"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                {Astro.generator}
            </a>
            hosted on
            <a
                href="https://github.com"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                GitHub</a
            >. Throughout my website, I use
            <a
                href="https://github.com/remarkjs/remark-math/"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                {remarkMathInfo.name}.js {remarkMathInfo.version}
            </a> with <a
                href="https://github.com/remarkjs/remark-math/tree/main/packages/rehype-mathjax"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                {rehypeMathJaxInfo.name}/chtml.js {rehypeMathJaxInfo.version}
            </a> for rendering <LaTeXLogo /> math expressions at <i
                >compile time</i
            >, <a
                href="https://echarts.apache.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                ECharts.js
            </a> for interactive plots, and <a
                href="https://github.com/timlrx/rehype-citation"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                {rehypeCitationInfo.name}.js {rehypeCitationInfo.version}
            </a> along with <a
                href="https://github.com/remarkjs/remark-gfm"
                target="_blank"
                rel="noopener noreferrer"
                class="coloured-link inline-block"
            >
                {remarkGfmInfo.name}.js {remarkGfmInfo.version}
            </a> for citations.
        </p>
    </section>
</BaseLayout>
