---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
    Card,
    CardContent,
    CardDescription,
    CardHeader,
    CardTitle,
} from "@/components/starwind/card";
const title = "Publications • Wo";
---

<!-- https://asouqi.github.io/bibtex-converter/ was utilised to convert bibfile contents to plaintext -->
<BaseLayout title={title}>
    <Card
        class="bg-[var(--theme-bg)]/50 backdrop-blur-sm outline-1 border-none shadow-md rounded-[6px]"
    >
        <CardHeader>
            <CardTitle class="cardtitle">Publications</CardTitle>
            <CardDescription class="pb-8"
                >Here are my scientific publications :)</CardDescription
            >
        </CardHeader>
        <CardContent class="flex flex-col gap-4">
            <ol class="list-inside list-disc">
                <li class="select-all">
                    K. J. Wo, G. Avis, F. Rozpędek, M.F. Mor-Ruiz, G. Pieplow,
                    T. Schröder, L. Jiang, A.S. Sørensen, J. Borregaard, "<i
                        >Resource-efficient fault-tolerant one-way quantum
                        repeater with code concatenation,</i
                    >" arxiv, Jun. 2023, doi: <a
                        class="coloured-link inline-block pb-4 select-all"
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://doi.org/10.48550/arXiv.2306.07224"
                        >10.48550/arXiv.2306.07224</a
                    >.
                </li>
                <li class="select-all">
                    K. J. Wo, "<i
                        >Hybrid one-way quantum repeater concatenated with the
                        [[5,1,3]] code,</i
                    >" TUDelft Repository, Apr. 2020, [Online]. Available: <a
                        class="coloured-link inline-block pb-4 select-all"
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://repository.tudelft.nl/islandora/object/uuid:649f5fe9-0266-4be2-a3a5-4b5ffd13073e"
                        >uuid:649f5fe9-0266-4be2-a3a5-4b5ffd13073e</a
                    >
                </li>
                <li class="select-all">
                    K. J. Wo, J. Peng, M. K. Prasad, Y. Shi, J. Li, and S. Wang,
                    "<i>Optical forces in coupled chiral particles,</i>" Phys.
                    Rev. A, vol. 102, no. 4, p. 043526, Oct. 2020, doi: <a
                        class="coloured-link inline-block pb-4"
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://journals.aps.org/pra/abstract/10.1103/PhysRevA.102.043526"
                        >10.1103/PhysRevA.102.043526</a
                    >.
                </li>
            </ol>
        </CardContent>
    </Card>
</BaseLayout>
