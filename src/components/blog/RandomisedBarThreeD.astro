---
const id = "randomised-bar3d-chart";
---

<script is:inline define:vars={{ id }}>
    document.addEventListener("DOMContentLoaded", () => {
        import("../src/scripts/echarts/plot.js")
            .then((plot) => {
                plot.createRandomisedBar3D(id, 25);
            })
            .catch((error) =>
                console.log(`Randomised bar3d chart Error! "${error}"`),
            );
    });
</script>

<div class="echarts" id={id}></div>
