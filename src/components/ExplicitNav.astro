---
import { MENU_LINKS } from "@/constants";
---

<nav class="divide-x flex-row hidden sm:flex md:flex lg:flex">
    {
        MENU_LINKS.map((link) => (
            <a
                href={link.path}
                class="hover:underline py-0 px-4 nav-anchor"
                rel="prefetch"
                aria-current={Astro.url.pathname === link.path ? "page" : false}
            >
                {link.title}
            </a>
        ))
    }
</nav>
