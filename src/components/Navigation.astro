---
import {
    Dropdown,
    DropdownTrigger,
    DropdownContent,
    DropdownItem,
} from "@/components/starwind/dropdown";
import { Button } from "@/components/starwind/button";
import WoLogo from "@/components/logo/WoLogo.astro";
import Hamburger from "@/components/logo/Hamburger.astro";
import ExplicitNav from "@/components/ExplicitNav.astro";
const animationMilliseconds = 150;
const buttonStrokeColour = "white";
const classWo = "w-auto h-14 outline-none";
---

<header>
    <div class="flex flex-row gap-4 items-center">
        <span class="block">
            <WoLogo classWo={classWo} />
        </span>
        <div>
            <span class="pl-4 text-2xl font-bold">Wo</span>
            <ExplicitNav />
        </div>
    </div>
    <Dropdown openOnHover closeDelay={animationMilliseconds}>
        <DropdownTrigger asChild>
            <Button
                variant="ghost"
                class="hover:bg-transparent focus:bg-transparent hover:shadow-lg focus:outline-none"
            >
                <Hamburger strokeColour={buttonStrokeColour} strokeWidth="0" />
                <!--
                    <svg
                    aria-hidden="true"
                    focusable="false"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="4"
                    stroke={buttonStrokeColour}
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 10h16.5m-16.5 10.75h16.5"></path>
                </Hamburger> -->
            </Button>
            <DropdownContent
                side="bottom"
                align="end"
                sideOffset={8}
                animationDuration={animationMilliseconds}
                class="shadow-md bg-background/0 outline-none border-none backdrop-blur-sm"
            >
                <DropdownItem as="a" href="/">Home</DropdownItem>
                <DropdownItem as="a" href="/publications"
                    >Publications</DropdownItem
                >
                <DropdownItem as="a" href="/posts">Blog</DropdownItem>
            </DropdownContent>
        </DropdownTrigger>
    </Dropdown>
</header>
